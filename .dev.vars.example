# Synthetic local bindings only. Copy to .dev.vars.development.
MAILHOOK_RECIPIENT="ingest@example.com"
BACKEND_WEBHOOK_URL="http://127.0.0.1:8788/email/webhook"
EMAIL_WEBHOOK_API_KEY="local-development-key"
